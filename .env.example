# 可作为 Docker Compose env_file，或保存为 /config/ur-monitor.env 供程序直接读取
# NAS 部署使用的 Docker Hub 镜像；本地源码构建不会使用此项
DOCKER_IMAGE=zhanggqdocker/ur-monitor:latest

UR_URLS=https://www.ur-net.go.jp/chintai/kanto/saitama/50_4090.html
CHECK_INTERVAL_SECONDS=600
NOTIFY_ON_FIRST_RUN=false

# 可选筛选（留空代表不限）；户型用英文逗号分隔
MIN_RENT=
MAX_RENT=
LAYOUTS=

# 邮件：下面以 Resend SMTP 为例，需要先验证发件域名
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_USER=resend
SMTP_PASSWORD=re_your_api_key
EMAIL_FROM="UR Monitor <notify@your-verified-domain.example>"
EMAIL_TO=you@example.com

PORT=8080
DATABASE_PATH=/data/ur-monitor.db
LOG_LEVEL=INFO
LOG_PATH=/data/ur-monitor.log
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=3
TZ=Asia/Tokyo
